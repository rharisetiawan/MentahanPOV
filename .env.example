# =========================================================================
# MentahanPOV — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env` to git.
# =========================================================================

# ---- Google Drive (OAuth2 installed-app, same client as YouTube below) ----
# Where the cached Drive OAuth token is stored after first-run consent.
GDRIVE_TOKEN_FILE=./credentials/gdrive-token.json
# ID of the MentahanPOV project ROOT folder (the one that CONTAINS
# "01 - Suasana Jalan & Perjalanan", etc, NOT a category subfolder itself).
# Get it from the folder URL: https://drive.google.com/drive/folders/<THIS_ID>
GDRIVE_FOLDER_ID=
# Pipe-separated ("|") because folder names may contain commas. Must match
# the actual subfolder names under GDRIVE_FOLDER_ID exactly. Only change
# this if you rename/add/remove category folders in Drive.
DRIVE_CATEGORIES=01 - Suasana Jalan & Perjalanan|02 - Cuaca & Hujan|03 - Alam, Hewan & ASMR|04 - Raw Photos & Textures|05 - Timelapse Assets

# ---- Gemini (Google AI Studio) ----
GEMINI_API_KEY=
# Video-capable Gemini model. gemini-2.5-flash = good balance of cost/quality;
# gemini-2.5-pro = higher quality, higher cost; gemini-flash-latest tracks current flash.
GEMINI_MODEL=gemini-2.5-flash
# Tried automatically if GEMINI_MODEL keeps 503ing with "high demand" —
# a different model's capacity is often less contested. Leave empty to
# disable and just fail once GEMINI_MODEL's own retries are exhausted.
# Google retires model names with little warning — if this starts
# 404ing "no longer available", see the comment above
# gemini_fallback_model in config.py for how to find a live replacement
# (don't guess one from memory/docs, both can be stale).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ---- YouTube Data API v3 (OAuth2 installed-app) ----
YOUTUBE_CLIENT_SECRETS=./credentials/youtube-oauth.json
YOUTUBE_TOKEN_FILE=./credentials/youtube-token.json
# public | unlisted | private
YOUTUBE_PRIVACY=public
# Category 22 = People & Blogs; 24 = Entertainment.
YOUTUBE_CATEGORY_ID=22

# ---- Facebook Page + Instagram Reels (Graph API v19+) ----
# Long-lived Page Access Token (60 days, refreshable).
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Instagram Business/Creator account ID linked to the FB Page above.
IG_USER_ID=
# Handle only (no @) — used to build a story link in the summary.
IG_USERNAME=
# Optional: override Graph API version.
GRAPH_API_VERSION=v19.0

# ---- Threads (Threads API — separate product from Graph API above) ----
# See README -> "Threads" for how to get these. FB_PAGE_ACCESS_TOKEN /
# IG_USER_ID above do NOT work here; this is a different host, different
# OAuth flow, different token. Leave both empty to skip Threads.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Optional: override Threads API version.
THREADS_API_VERSION=v1.0

# ---- Watermark / posting-copy rendering ----
# PNG with alpha channel. If missing, a placeholder "MentahanPOV" text logo
# is auto-generated here on first run — drop your real logo at this exact
# path any time to replace it, no code changes needed.
WATERMARK_LOGO_PATH=./assets/watermark-logo.png
# 0.0-1.0. How "tipis" the logo looks once overlaid (applies to placeholder
# and real logo alike).
WATERMARK_OPACITY=0.35
# Logo width as a fraction of video width, NOT pixels (0.18 = 18%) — a
# fixed px size reads as huge on a 720p clip and vanishes on 4K.
WATERMARK_WIDTH_PCT=0.18
# Where rendered (watermarked, feed-sized) posting copies are cached.
POSTING_COPY_DIR=./state/posting_copies
# Bot dry-runs render the posting copy in parallel with Gemini + Drive, so
# Post only has to publish. Set false if the box runs out of RAM doing both.
PRERENDER_POSTING_COPY=true

# ---- Telegram bot front-end (telegram_bot.py) ----
# From @BotFather -> /newbot. Leave empty if you're not using the bot.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to trigger the bot.
# Message @userinfobot to find your own id. Leave empty = anyone with the
# bot's link can trigger it (not recommended).
TELEGRAM_ALLOWED_USER_IDS=
# Optional: override which platforms the bot posts to (comma-separated).
# Leave empty to use PLATFORMS above.
TELEGRAM_PLATFORMS=
# Optional: run a Local Bot API Server (see README -> "Telegram bot" ->
# "Removing the 20MB download cap") to receive full-size raw phone footage
# instead of api.telegram.org's 20MB limit. From https://my.telegram.org ->
# "API development tools". Leave both empty to use api.telegram.org as-is.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Base URL of the running Local Bot API Server. Only used when the two
# values above are set; default matches the official Docker image's port.
TELEGRAM_LOCAL_API_URL=http://localhost:8081
# Hour (0-23, WIB) the daily /status-style report is sent automatically
# to everyone in TELEGRAM_ALLOWED_USER_IDS. Skipped entirely if that list
# is empty (nowhere to send it) — /status still works on demand either way.
DAILY_STATUS_HOUR=8

# ---- Automatic disk cleanup (core/cleanup.py) ----
# Every day at 04:00 WIB the bot deletes finished jobs' master (incoming/) and
# posting copies (state/posting_copies/) once they're older than this many
# days AND the master is on Drive AND every platform (except the ignored
# ones below) is "ok". Jobs with a failed platform are kept for retry.
# /cleanup in Telegram previews it, /cleanup apply runs it on demand.
CLEANUP_RETENTION_DAYS=3
# Old TikTok results (now archived) must not pin files forever.
CLEANUP_IGNORE_PLATFORMS=tiktok
# Telegram disk alert (checked every 6h, silent while OK) + red in /status.
DISK_WARN_FREE_PCT=25
DISK_ERROR_FREE_PCT=12
# The bot runs that cleanup by itself (after each run, daily at CLEANUP_HOUR
# WIB, and as soon as free disk drops under DISK_PRESSURE_FREE_GB, when the
# retention window is skipped). false = only scripts/cleanup_storage.py / the
# /cleanup command ever delete anything.
# (DISK_PRESSURE_FREE_GB is capped at 25% of the disk's total size, so on the
# HG680's ~6.5 GB internal storage it behaves as ~1.6 GB, not a permanent 2.)
AUTO_CLEANUP=true
CLEANUP_HOUR=4
# OPT-IN. A video that was reviewed (master already on Drive) but never
# posted, scheduled or cancelled can be deleted locally after this many days —
# what tapping ❌ Batal would have done. Tapping ✅ Post on it afterwards says
# "file sudah gak ada, kirim ulang". 0 (default) = never delete those
# automatically; they show up under "unfinished" in /cleanup instead.
ABANDONED_RETENTION_DAYS=0
DISK_PRESSURE_FREE_GB=2
# A new video is refused (with an explanation, nothing half-downloaded) when
# free disk, after a pressure cleanup, is below its size + this many MB.
UPLOAD_MIN_FREE_MB=1024

# ---- Status dashboard (dashboard.py) + Telegram /status (core/health.py) ----
# LAN-only by design — see DEPLOYMENT.md. http://<box-ip>:DASHBOARD_PORT
DASHBOARD_USER=admin
# REQUIRED — dashboard.py refuses to start without this set. Pick
# something you wouldn't mind a housemate on the same WiFi guessing.
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8090
# Facebook/Instagram and Threads tokens get flagged once within this many
# days of their real (Graph-API-reported) expiry.
TOKEN_WARN_DAYS=7

# ---- Admin dashboard (admin.py) — read-write, separate host process ----
# See DEPLOYMENT.md -> "Admin dashboard". Reuses DASHBOARD_USER/PASSWORD
# above. Runs on the host directly (systemd unit), not in docker-compose.
ADMIN_PORT=8091
# Full URL the bot's /dashboard command replies with — use this box's
# Tailscale IP (not the LAN one) so the link works from outside the house
# too, e.g. http://100.73.125.7:8091. Leave empty to have /dashboard just
# point at DEPLOYMENT.md instead.
ADMIN_DASHBOARD_URL=

# ---- Orchestration ----
# Comma-separated. Drop platforms you don't want to post to.
# Available: youtube, facebook, instagram, threads,
#            facebook_story, instagram_story
# (tiktok is archived — see archive/tiktok/README.md.)
# threads is left out of the default below until its credentials are
# actually set up (see the section above) — add it here once ready.
PLATFORMS=youtube,facebook,instagram,facebook_story,instagram_story
# Path to JSON state file (idempotent retries).
STATE_FILE=./state/posts.json
# ---- Liveness / outage alerts (DEPLOYMENT.md -> "Liveness & outage alerts") ----
# The bot writes state/heartbeat.json this often; it's what the startup
# "online lagi, sempat mati X" message and scripts/watchdog.py read.
HEARTBEAT_INTERVAL_MIN=5
# Optional dead-man's switch: the bot GETs this URL on every beat. Create a
# check at healthchecks.io (or similar) with a ~15 min grace period and put
# its ping URL here — you get alerted when the pings STOP, which still works
# when the whole box (or its internet) is gone. Treat the URL as a secret.
HEARTBEAT_PING_URL=

# ---- Google OAuth token age ----
# While the Google Cloud consent screen is in "Testing", refresh tokens die ~7
# days after consent. /status uses this to count down and warn a day or two
# BEFORE that, for tokens whose consent date is known (re-run
# scripts/reauth_google.py once so it's recorded). Set 0 after moving the app
# to Production, where no such expiry applies.
GOOGLE_TOKEN_MAX_AGE_DAYS=7

# ---- Post performance (core/insights.py) ----
# YouTube view counts need a plain API key (Google Cloud -> APIs & Services ->
# enable "YouTube Data API v3" -> Credentials -> API key). The upload-only
# OAuth token can't read statistics. Leave empty to skip YouTube; Facebook/
# Instagram/Threads reuse the tokens above (they need the insights permission).
YOUTUBE_API_KEY=
INSIGHTS_ENABLED=true
# How many of the best-performing past hooks Gemini sees as style reference
# (0 = never), and how many posts need numbers before it sees any.
CAPTION_TOP_HOOKS=3
INSIGHTS_MIN_SAMPLES=5

# ---- Scheduled posting (the 📅 Jadwalkan button) ----
# Hours (0-23, WIB) offered as "next slot" buttons, comma-separated.
SCHEDULE_SLOT_HOURS=7,12,19
