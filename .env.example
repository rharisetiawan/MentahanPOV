# =========================================================================
# MentahanPOV — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env` to git.
# =========================================================================

# ---- Google Drive (OAuth2 installed-app, same client as YouTube below) ----
# Where the cached Drive OAuth token is stored after first-run consent.
GDRIVE_TOKEN_FILE=./credentials/gdrive-token.json
# ID of the MentahanPOV project ROOT folder (the one that CONTAINS
# "01 - Suasana Jalan & Perjalanan", etc, NOT a category subfolder itself).
# Get it from the folder URL: https://drive.google.com/drive/folders/<THIS_ID>
GDRIVE_FOLDER_ID=
# Pipe-separated ("|") because folder names may contain commas. Must match
# the actual subfolder names under GDRIVE_FOLDER_ID exactly. Only change
# this if you rename/add/remove category folders in Drive.
DRIVE_CATEGORIES=01 - Suasana Jalan & Perjalanan|02 - Cuaca & Hujan|03 - Alam, Hewan & ASMR|04 - Raw Photos & Textures|05 - Timelapse Assets

# ---- Gemini (Google AI Studio) ----
GEMINI_API_KEY=
# Video-capable Gemini model. gemini-2.5-flash = good balance of cost/quality;
# gemini-2.5-pro = higher quality, higher cost; gemini-flash-latest tracks current flash.
GEMINI_MODEL=gemini-2.5-flash

# ---- YouTube Data API v3 (OAuth2 installed-app) ----
YOUTUBE_CLIENT_SECRETS=./credentials/youtube-oauth.json
YOUTUBE_TOKEN_FILE=./credentials/youtube-token.json
# public | unlisted | private
YOUTUBE_PRIVACY=public
# Category 22 = People & Blogs; 24 = Entertainment.
YOUTUBE_CATEGORY_ID=22

# ---- Facebook Page + Instagram Reels (Graph API v19+) ----
# Long-lived Page Access Token (60 days, refreshable).
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Instagram Business/Creator account ID linked to the FB Page above.
IG_USER_ID=
# Handle only (no @) — used to build a story link in the summary.
IG_USERNAME=
# Optional: override Graph API version.
GRAPH_API_VERSION=v19.0

# ---- Threads (Threads API — separate product from Graph API above) ----
# See README -> "Threads" for how to get these. FB_PAGE_ACCESS_TOKEN /
# IG_USER_ID above do NOT work here; this is a different host, different
# OAuth flow, different token. Leave both empty to skip Threads.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Optional: override Threads API version.
THREADS_API_VERSION=v1.0

# ---- TikTok (Playwright) ----
# Storage state file produced by `python -m distributors.tiktok login`.
TIKTOK_STORAGE_STATE=./credentials/tiktok-storage.json
# Set to "true" once login is saved; "false" while logging in.
TIKTOK_HEADLESS=false

# ---- Watermark / posting-copy rendering ----
# PNG with alpha channel. If missing, a placeholder "MentahanPOV" text logo
# is auto-generated here on first run — drop your real logo at this exact
# path any time to replace it, no code changes needed.
WATERMARK_LOGO_PATH=./assets/watermark-logo.png
# 0.0-1.0. How "tipis" the logo looks once overlaid (applies to placeholder
# and real logo alike).
WATERMARK_OPACITY=0.35
# Logo width as a fraction of video width, NOT pixels (0.18 = 18%) — a
# fixed px size reads as huge on a 720p clip and vanishes on 4K.
WATERMARK_WIDTH_PCT=0.18
# Where rendered (watermarked, feed-sized) posting copies are cached.
POSTING_COPY_DIR=./state/posting_copies

# ---- Telegram bot front-end (telegram_bot.py) ----
# From @BotFather -> /newbot. Leave empty if you're not using the bot.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to trigger the bot.
# Message @userinfobot to find your own id. Leave empty = anyone with the
# bot's link can trigger it (not recommended).
TELEGRAM_ALLOWED_USER_IDS=
# Optional: override which platforms the bot posts to (comma-separated).
# Leave empty to use PLATFORMS above.
TELEGRAM_PLATFORMS=
# Optional: run a Local Bot API Server (see README -> "Telegram bot" ->
# "Removing the 20MB download cap") to receive full-size raw phone footage
# instead of api.telegram.org's 20MB limit. From https://my.telegram.org ->
# "API development tools". Leave both empty to use api.telegram.org as-is.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Base URL of the running Local Bot API Server. Only used when the two
# values above are set; default matches the official Docker image's port.
TELEGRAM_LOCAL_API_URL=http://localhost:8081

# ---- Orchestration ----
# Comma-separated. Drop platforms you don't want to post to.
# Available: youtube, facebook, instagram, threads, tiktok,
#            facebook_story, instagram_story
# threads and tiktok are left out of the default below until their
# credentials/login are actually set up (see the sections above) —
# add them here once ready.
PLATFORMS=youtube,facebook,instagram,facebook_story,instagram_story
# Path to JSON state file (idempotent retries).
STATE_FILE=./state/posts.json
